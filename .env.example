# Public Supabase project values only. Copy to .env.local and replace with the values
# from Supabase Dashboard → Project Settings → API Keys / Connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy public anon keys are also accepted by the client utilities:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
